# Notion integration — required to pull real blog posts.
# Until these are set, the site renders sample posts from src/lib/mock-posts.ts.

# 1) Create an integration at https://www.notion.so/my-integrations
#    Copy its "Internal Integration Secret" here.
NOTION_TOKEN=

# 2) Create a database in Notion with these properties:
#      Title (title), Slug (text), Published (checkbox),
#      Date (date), Summary (text), Tags (multi-select)
#    Share the database with your integration (••• > Connections),
#    then copy the database ID from its URL (the 32-char hash).
NOTION_DATABASE_ID=

# 3) A random string used to protect the on-demand revalidation endpoint.
#    Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=

# Blog view counts (optional) — Upstash Redis.
# Create a free database at https://console.upstash.com and copy the REST
# URL + token here. Without these, posts show a placeholder view count.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
